<UserControl
    x:Class="Reserveroom.views.ReservationListingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Reserveroom.viewModels"
    d:DataContext="{d:DesignInstance Type=vm:ReservationListingViewModel}"
    mc:Ignorable="d">
    <Grid Margin="20" HorizontalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="24"
            FontWeight="Bold"
            Text="View Reservation" />
        <Button
            Grid.Row="0"
            Grid.Column="1"
            VerticalAlignment="Center"
            Command="{Binding MakeReservationCommand}"
            Content="Make Reservation" />

        <DataGrid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,20,0,0"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding Reservations}">
            <!--  Binding Reservations là property trong ReservationListingViewModel  -->
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding RoomID}"
                    Header="Room ID" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding UserName}"
                    Header="UserName" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding StartDate}"
                    Header="StartDate" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding EndDate}"
                    Header="End Date" />
                <DataGridTemplateColumn Width="100" Header="Thao tác">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!--  Nút bấm nằm trên mỗi dòng  -->
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="8,3"
                                    Background="#3498DB"
                                    Command="{Binding EditReservationCommand}"
                                    Content="Sửa"
                                    Cursor="Hand"
                                    Foreground="White" />
                                <Button
                                    Padding="5,2"
                                    Background="#E74C3C"
                                    Command="{Binding DeleteReservationCommand}"
                                    Content="Xóa"
                                    Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
