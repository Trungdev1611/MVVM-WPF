<UserControl
    x:Class="Reserveroom.views.MakeReservationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Reserveroom"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <!--  Grid tổng: Giới hạn MaxWidth = 600 và căn giữa màn hình  -->
    <Grid
        MaxWidth="800"
        Margin="20"
        HorizontalAlignment="Center">
        <!--  Định nghĩa 5 Hàng, mỗi hàng có chiều cao tự động  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Tiêu đề "Make Reservation" ở hàng đầu  -->
        <TextBlock
            Grid.Row="0"
            FontSize="24"
            FontWeight="Bold"
            Text="Make Reservation" />

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>



            <TextBlock Grid.Row="0" Text="Username" />
            <TextBox
                Grid.Row="1"
                Margin="0,5,0,0"
                Padding="5"
                Text="{Binding Username}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                Text="Floor No" />
            <TextBox
                Grid.Row="1"
                Grid.Column="0"
                MinWidth="120"
                Margin="0,5,5,0"
                Padding="5"
                Text="{Binding FloorNo}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="Room No" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                MinWidth="120"
                Margin="0,5,0,0"
                Padding="5"
                Text="{Binding RoomNo}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                Text="Start Date" />
            <DatePicker
                Grid.Row="1"
                Grid.Column="0"
                MinWidth="120"
                Margin="0,5,5,0"
                Padding="5"
                SelectedDate="{Binding StartDate}"/>

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="End Date" />
            <DatePicker
                Grid.Row="1"
                Grid.Column="1"
                MinWidth="120"
                Margin="0,5,0,0"
                Padding="5"
                SelectedDate="{Binding EndDate}"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation = "Horizontal" Margin="0 10 0 0">
            <Button Content = "Submit" Padding="10" 
                Command="{Binding MakeReservationSubmitCommand}"
                />
            <Button Content = "Cancel" Margin="5 0 0 0" Padding="10" Command="{Binding MakeReservationCancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
